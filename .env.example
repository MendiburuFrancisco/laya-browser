# TypeSafe System One API key
# For the local backend set JEV_BACKEND=laya (no TypeSafe key required).
# JEV_API_URL=http://127.0.0.1:8791/v1/systemone
# Jev images/Box only. Defaults: presence 0.85, Box confidence 0.60.
# These do not change DOM, completion, or irreversible-action thresholds.
# JEV_IMAGE_MIN_PRESENCE=0.70
# JEV_IMAGE_MIN_CONFIDENCE=0.70
# MCP launch viewport (set in the MCP process environment):
# JEV_BROWSER_VIEWPORT={"width":1280,"height":800}
# JEV_BROWSER_VIEWPORT=null
# Persistent browser downloads directory (defaults to ~/Downloads/laya-browser)
# JEV_BROWSER_DOWNLOADS_DIR=C:\\Users\\you\\Downloads\\laya-browser
# Optional MCP video recording (silent WebM per tab; browser_stop_recording saves without closing)
# JEV_BROWSER_VIDEO_DIR=C:\\Users\\you\\Videos\\laya-browser
# One of these: a TypeSafe System One key, or an OpenRouter key (Jev through OpenRouter).
# If both are set, TYPESAFE_API_KEY wins.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Local test executor (see docs/executor-local.md)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EXECUTOR_API_TOKEN=
# EXECUTOR_API_URL=http://127.0.0.1:8787

# Optional Android native MCP target (web remains the default; no Appium dependency).
# Run Appium separately: appium --address 127.0.0.1 --port 4723
# APPIUM_URL=http://127.0.0.1:4723
# JEV_MOBILE_ENABLED=0  # explicit rollback: reject Android session launches
# Opt-in E2E on a dedicated emulator only:
# JEV_ANDROID_E2E=1
# JEV_ANDROID_JEV_E2E=1
# ANDROID_UDID=emulator-5554
