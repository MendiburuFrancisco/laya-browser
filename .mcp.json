{
  "mcpServers": {
    "laya-browser": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/laya-browser-mcp.mjs"
      ],
      "env": {
        "JEV_BACKEND": "${user_config.backend}",
        "TYPESAFE_API_KEY": "${user_config.typesafe_api_key}",
        "OPENROUTER_API_KEY": "${user_config.openrouter_api_key}",
        "JEV_BROWSER_HEADED": "${user_config.headed}",
        "JEV_BROWSER": "${user_config.browser}",
        "JEV_BROWSER_PROFILE": "${user_config.browser_profile}"
      }
    }
  }
}
