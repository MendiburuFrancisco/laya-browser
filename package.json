{
  "name": "laya-browser",
  "version": "0.2.1",
  "description": "Browser automation with Laya local and Jev (Typesafe System One) decision backends. Library, CLI and MCP server.",
  "keywords": [
    "mcp",
    "mcp-server",
    "browser-automation",
    "playwright",
    "llm",
    "agent",
    "jev",
    "laya",
    "typesafe",
    "claude",
    "claude-code-plugin"
  ],
  "license": "MIT",
  "author": "Ying-Kai Liao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MendiburuFrancisco/laya-browser.git"
  },
  "homepage": "https://github.com/MendiburuFrancisco/laya-browser#readme",
  "bugs": {
    "url": "https://github.com/MendiburuFrancisco/laya-browser/issues"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "laya-browser": "bin/laya-browser.mjs",
    "laya-browser-mcp": "bin/laya-browser-mcp.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "examples/",
    "local/*.py",
    "local/*.mjs",
    "local/requirements.txt",
    "MCP-LAYA.md",
    "README.md",
    "NOTES.md",
    "RESULTS.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/mcp.e2e.mjs",
    "bench": "node bench/run.mjs",
    "bench:cost": "node bench/context-cost.mjs",
    "bench:compare": "node bench/compare-backends.mjs",
    "examples:jev": "node bench/compare-backends.mjs --backend jev --headed --repetitions 1 --pause-ms 3000 --out bench/results/jev-examples",
    "examples:laya": "node bench/compare-backends.mjs --backend laya --headed --repetitions 1 --pause-ms 3000 --out bench/results/laya-examples",
    "mcp": "node bin/laya-browser-mcp.mjs",
    "cost": "node bin/jev-cost.mjs",
    "setup": "npx playwright install chromium",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json .mcp.json",
    "validate": "node scripts/sync-plugin-version.mjs --check && claude plugin validate . --strict"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.63.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.6.5"
  }
}
